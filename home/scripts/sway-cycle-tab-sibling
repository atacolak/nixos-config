#!/usr/bin/env python3
"""Cycle focus across siblings in the nearest tabbed/stacked parent."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from typing import Any


LAYOUTS = {"tabbed", "stacked"}


def run_sway_json(command: str) -> Any:
    proc = subprocess.run(
        ["swaymsg", "-t", command],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or f"swaymsg -t {command} failed")
    return json.loads(proc.stdout)


def focus_con_id(con_id: int) -> None:
    subprocess.run(
        ["swaymsg", f"[con_id={con_id}] focus"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
    )


def find_focused_path(node: dict[str, Any]) -> list[dict[str, Any]] | None:
    if node.get("focused") is True:
        return [node]

    for key in ("nodes", "floating_nodes"):
        for child in node.get(key, []):
            path = find_focused_path(child)
            if path is not None:
                return [node, *path]
    return None


def pick_target_sibling(path: list[dict[str, Any]], reverse: bool) -> int | None:
    # Walk ancestors nearest-first and choose the first tabbed/stacked parent
    # with at least two direct children.
    for idx in range(len(path) - 2, -1, -1):
        parent = path[idx]
        child = path[idx + 1]

        siblings = parent.get("nodes", [])
        if parent.get("layout") not in LAYOUTS or len(siblings) < 2:
            continue
        if child not in siblings:
            continue

        cur_idx = siblings.index(child)
        if reverse:
            target = siblings[(cur_idx - 1) % len(siblings)]
        else:
            target = siblings[(cur_idx + 1) % len(siblings)]
        return int(target["id"])

    return None


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--reverse", action="store_true")
    args = parser.parse_args()

    tree = run_sway_json("get_tree")
    path = find_focused_path(tree)
    if not path:
        return 1

    target_id = pick_target_sibling(path, reverse=args.reverse)
    if target_id is None:
        return 0

    focus_con_id(target_id)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as exc:
        print(f"sway-cycle-tab-sibling: {exc}", file=sys.stderr)
        raise SystemExit(1)
