#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  hypr-cycle-or-run --class <regex> --launch <cmd...> [--scope current|any] [--reverse]

Focus the next matching Hyprland client; launch the command if none exists.
USAGE
}

die() { echo "hypr-cycle-or-run: $*" >&2; exit 2; }

class_regex=""
scope="current"
reverse="false"
launch_cmd=()

while (($# > 0)); do
  case "$1" in
    --class)
      [[ $# -ge 2 ]] || die "missing value for --class"
      class_regex="$2"
      shift 2
      ;;
    --scope)
      [[ $# -ge 2 ]] || die "missing value for --scope"
      scope="$2"
      shift 2
      ;;
    --reverse)
      reverse="true"
      shift
      ;;
    --launch)
      shift
      [[ $# -gt 0 ]] || die "missing command after --launch"
      launch_cmd=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n "$class_regex" ]] || die "--class is required"
((${#launch_cmd[@]} > 0)) || die "--launch is required"
[[ "$scope" == "current" || "$scope" == "any" ]] || die "--scope must be current or any"

if ! clients_json="$(hyprctl clients -j 2>/dev/null)"; then
  setsid -f "${launch_cmd[@]}" >/dev/null 2>&1 || true
  exit 0
fi

active_addr="$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')"
current_ws="$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')"

# shellcheck disable=SC2016
jq_filter='[.[] | select((.class // "") | test($re; "i"))'
if [[ "$scope" == "current" && -n "$current_ws" ]]; then
  # shellcheck disable=SC2016
  jq_filter+=' | select(.workspace.id == ($ws | tonumber))'
fi
jq_filter+='] | sort_by(.focusHistoryID // 999999) | .[].address'

mapfile -t addresses < <(jq -r --arg re "$class_regex" --arg ws "$current_ws" "$jq_filter" <<<"$clients_json")

if ((${#addresses[@]} == 0)); then
  setsid -f "${launch_cmd[@]}" >/dev/null 2>&1 || true
  exit 0
fi

idx=-1
for i in "${!addresses[@]}"; do
  if [[ "${addresses[$i]}" == "$active_addr" ]]; then
    idx="$i"
    break
  fi
done

if [[ "$reverse" == "true" ]]; then
  next=$((idx - 1))
  if ((next < 0)); then next=$((${#addresses[@]} - 1)); fi
else
  next=$((idx + 1))
  if ((next >= ${#addresses[@]})); then next=0; fi
fi

hyprctl dispatch focuswindow "address:${addresses[$next]}" >/dev/null
