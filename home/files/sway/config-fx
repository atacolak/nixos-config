# swayfx session overlay: same bindings and layout as the daily sway config,
# plus the fx eye candy. Plain sway never loads this file.
include /home/sf/.config/sway/config

blur enable
blur_radius 8
blur_passes 3
blur_noise 0.02
blur_brightness 0.9
corner_radius 12
shadows enable
shadow_blur_radius 20
shadow_color #00000099
default_dim_inactive 0.5
titlebar_separator disable
