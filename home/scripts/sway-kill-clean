import json
import os
import shutil
import subprocess
import sys
import time

swaymsg = shutil.which("swaymsg") or "/run/current-system/sw/bin/swaymsg"

def run(args, check=False):
    return subprocess.run([swaymsg, *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)

def get_tree():
    proc = run(["-t", "get_tree"])
    if proc.returncode != 0:
        return None
    return json.loads(proc.stdout)

def focused_path(node, path=None):
    path = (path or []) + [node]
    if node.get("focused"):
        return path
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found = focused_path(child, path)
        if found:
            return found
    return None

def leaf_count(node):
    children = node.get("nodes", []) + node.get("floating_nodes", [])
    if not children:
        return 1 if node.get("type") == "con" else 0
    return sum(leaf_count(c) for c in children)

def focused_inside_single_child_wrapper(path):
    if not path or len(path) < 4:
        return False
    # path: root -> output -> workspace -> ... -> focused leaf
    wrappers = path[3:-1]
    return any(w.get("type") == "con" and leaf_count(w) == 1 for w in wrappers)

# Kill first, then if Sway leaves the survivor buried inside a one-window
# tabbed/stacked/split wrapper, pull it back up to the workspace root. This
# approximates the collapse i3 users expect after killing one sibling.
run(["kill"])
time.sleep(0.16)

tree = get_tree()
path = focused_path(tree) if tree else None
if path and focused_inside_single_child_wrapper(path):
    run(["move", "container", "to", "workspace", "current"])
