{
  "manifest_version": 3,
  "name": "Mullvad Region (browser-only)",
  "version": "1.2.1",
  "description": "Switch or drop the browser-only Mullvad exit. Host and system VPN are untouched.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mullvad region",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
