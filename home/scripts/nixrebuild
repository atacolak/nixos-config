#!/usr/bin/env bash
# nixrebuild — eval then switch ~/nixos-config#{laptop,desktop}.
# attr follows hostname unless NIXREBUILD_ATTR is set.
# you type sudo. agents should not run this unattended.
set -euo pipefail

FLAKE="${NIXREBUILD_FLAKE:-/home/sf/nixos-config}"

host_attr() {
  case "$(hostname -s 2>/dev/null || hostname)" in
    sfnix) echo laptop ;;
    sfub) echo desktop ;;
    *) echo "" ;;
  esac
}

ATTR="${NIXREBUILD_ATTR:-$(host_attr)}"
usage() {
  cat <<'EOF'
nixrebuild — sudo nixos-rebuild switch --flake ~/nixos-config#{laptop,desktop}

  nixrebuild           eval, then switch
  nixrebuild --eval    eval only, no switch
  nixrebuild --dry     nixos-rebuild dry-run
  nixrebuild --help

attr is sfnix→laptop, sfub→desktop. override with NIXREBUILD_ATTR.
refuses to switch if the evaluated config drops services.netbird.enable.
refuses to switch the other machine's attr on this hostname.
that is how gen 111 made the box dark.
EOF
}

MODE="switch"
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --eval|--eval-only) MODE="eval" ;;
  --dry|--dry-run) MODE="dry" ;;
  "") MODE="switch" ;;
  *)
    echo "unknown arg: $1 (try --help)" >&2
    exit 2
    ;;
esac


if [[ -z "$ATTR" ]]; then
  echo "!! no flake attr for hostname $(hostname). set NIXREBUILD_ATTR=laptop|desktop" >&2
  exit 2
fi

live="$(hostname -s 2>/dev/null || hostname)"
if [[ "$live" == "sfnix" && "$ATTR" != "laptop" ]]; then
  echo "!! refusing to switch #$ATTR on sfnix (laptop only)" >&2
  exit 1
fi
if [[ "$live" == "sfub" && "$ATTR" != "desktop" ]]; then
  echo "!! refusing to switch #$ATTR on sfub (desktop only)" >&2
  exit 1
fi

if [[ "$MODE" != "eval" && ! -e /run/current-system ]]; then
  echo "!! not a running nixos system. use --eval, or see docs/runbooks/desktop-install.md" >&2
  exit 1
fi
cd "$FLAKE"

echo ">> flake $FLAKE#$ATTR"
echo ">> current $(readlink /run/current-system)"
git status --short || true

untracked_nix="$(git ls-files --others --exclude-standard -- '*.nix' 'flake.lock' 'home/scripts/*' 'pkgs/*' || true)"
if [[ -n "$untracked_nix" ]]; then
  echo "!! untracked nix-read files (flake cannot see these):" >&2
  printf '%s\n' "$untracked_nix" >&2
  echo "!! git add them, then re-run nixrebuild" >&2
  exit 1
fi

echo ">> eval netbird"
netbird_on="$(nix eval --impure --expr '(builtins.getFlake "'"$FLAKE"'").nixosConfigurations.'"$ATTR"'.config.services.netbird.enable' || true)"
if [[ "$netbird_on" != "true" ]]; then
  echo "!! evaluated config has services.netbird.enable = ${netbird_on:-unset}" >&2
  echo "!! aborting. last time a switch without netbird dropped the overlay." >&2
  exit 1
fi
echo ">> netbird.enable = true"

echo ">> eval toplevel"
toplevel="$(nix eval --raw ".#nixosConfigurations.${ATTR}.config.system.build.toplevel")"
echo ">> $toplevel"

if [[ "$MODE" == "eval" ]]; then
  echo ">> eval-only, not switching"
  exit 0
fi

if [[ "$MODE" == "dry" ]]; then
  echo ">> dry-run"
  exec sudo nixos-rebuild dry-run --flake "${FLAKE}#${ATTR}"
fi

echo ">> switch (sudo)"
sudo nixos-rebuild switch --flake "${FLAKE}#${ATTR}"
echo ">> now $(readlink /run/current-system)"
systemctl --no-pager is-active home-manager-sf.service || true
systemctl --no-pager is-active netbird || true
command -v nixrebuild >/dev/null && echo ">> nixrebuild on PATH"
command -v nixrollback >/dev/null && echo ">> nixrollback on PATH"
