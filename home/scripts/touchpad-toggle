#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="$state_dir/hypr-touchpad-enabled"

if [[ -f "$state_file" && "$(cat "$state_file" 2>/dev/null)" == "0" ]]; then
  next=1
  label="enabled"
else
  next=0
  label="disabled"
fi

# Hyprland device names are libinput names lowercased with spaces normalized to hyphens.
# The laptop touchpad currently appears as ASUP1204:00 093A:200C Touchpad.
hyprctl keyword 'device[asup1204:00-093a:200c-touchpad]:enabled' "$next" >/dev/null
printf '%s' "$next" > "$state_file"

if command -v notify-send >/dev/null 2>&1; then
  notify-send "touchpad" "$label"
else
  echo "touchpad -> $label"
fi
