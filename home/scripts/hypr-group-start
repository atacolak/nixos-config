#!/usr/bin/env bash
set -euo pipefail

active_json=$(hyprctl activewindow -j 2>/dev/null || true)
if [[ -z "$active_json" || "$active_json" == "null" ]]; then
  exit 0
fi

# Super+W should create/enter deck mode, not destroy an existing deck.
if [[ $(jq '(.grouped // []) | length' <<<"$active_json") -eq 0 ]]; then
  hyprctl dispatch togglegroup
fi
