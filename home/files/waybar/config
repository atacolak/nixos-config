{
  "layer": "top",
  "position": "top",
  "mode": "hide",
  "modifier-reset": "release",
  "height": 28,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "disk", "battery"],
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": { "*": 10 }
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 80,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 5
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "net {ipaddr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-ethernet": "net {ipaddr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-disconnected": "net down",
    "interval": 2
  },
  "cpu": { "format": "cpu {usage}%", "interval": 3 },
  "memory": { "format": "mem {used:0.1f}g", "interval": 5 },
  "disk": { "format": "disk {free}", "path": "/", "interval": 20 },
  "battery": { "format": "bat {capacity}%", "format-charging": "bat {capacity}%+" }
}
