#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path


def is_firefox_entry(entry):
    if not isinstance(entry, dict):
        return False
    command = entry.get("command")
    if not isinstance(command, list) or not command:
        return False
    first = command[0]
    if not isinstance(first, str):
        return False
    launcher = os.path.basename(first).lower()
    return launcher == "fox" or "firefox" in launcher


def main():
    if len(sys.argv) != 2:
        print(
            "Usage: i3-resurrect-prune-firefox-programs <workspace_programs.json>",
            file=sys.stderr,
        )
        return 1

    target = Path(sys.argv[1]).expanduser()
    if not target.exists():
        print(f"i3-resurrect-prune-firefox-programs: file not found: {target}", file=sys.stderr)
        return 0

    try:
        payload = json.loads(target.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"i3-resurrect-prune-firefox-programs: failed to read {target}: {exc}", file=sys.stderr)
        return 1

    if not isinstance(payload, list):
        print(
            f"i3-resurrect-prune-firefox-programs: expected a JSON list in {target}",
            file=sys.stderr,
        )
        return 1

    filtered = [entry for entry in payload if not is_firefox_entry(entry)]
    removed = len(payload) - len(filtered)
    if removed == 0:
        return 0

    target.write_text(json.dumps(filtered, indent=2) + "\n", encoding="utf-8")
    print(
        f"i3-resurrect-prune-firefox-programs: removed {removed} firefox entry(s) from {target}",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
