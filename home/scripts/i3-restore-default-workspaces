#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2088
set -euo pipefail

if ! command -v i3-resurrect >/dev/null 2>&1; then
  echo "i3-restore-default-workspaces: i3-resurrect is not in PATH" >&2
  exit 1
fi

prune_firefox="${I3_RESURRECT_PRUNE_FIREFOX_CMD:-i3-resurrect-prune-firefox-programs}"
if ! command -v "${prune_firefox}" >/dev/null 2>&1 && [[ ! -x "${prune_firefox}" ]]; then
  echo "i3-restore-default-workspaces: firefox prune helper not found: ${prune_firefox}" >&2
  exit 1
fi

resurrect_dir="${I3_RESURRECT_DIR:-$HOME/.i3/i3-resurrect}"
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    -d|--directory)
      if ((i + 1 < ${#args[@]})); then
        resurrect_dir="${args[i + 1]}"
      fi
      ;;
    --directory=*)
      resurrect_dir="${args[i]#*=}"
      ;;
  esac
done
if [[ "${resurrect_dir}" == "~" ]]; then
  resurrect_dir="${HOME}"
fi

workspaces=(1 2 3)
for ws in "${workspaces[@]}"; do
  "${prune_firefox}" "${resurrect_dir}/workspace_${ws}_programs.json"
  i3-resurrect restore --workspace "$ws" --numeric "$@"
done
