#!/usr/bin/env bash
# Browser-only Mullvad. Same verbs as `mullvad`, scoped to cloak / mullvad-browser.
# Does not change host routing, Tailscale, or system `mullvad`.
# shellcheck disable=SC2016
set -euo pipefail

CTL="${BMULLVAD_CTL:-/etc/bmullvad/ctl}"
NSEXEC="${BMULLVAD_NSEXEC:-/etc/bmullvad/nsexec}"
NS_PATH="${BMULLVAD_NS_PATH:-/var/run/netns/vpn-browser}"
SUDO="${BMULLVAD_SUDO:-/run/wrappers/bin/sudo}"
WG="${WG:-wg}"
CURL="${CURL:-curl}"
JQ="${JQ:-jq}"

CONF_DIR="${BMULLVAD_CONF_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/bmullvad}"
CACHE_DIR="${BMULLVAD_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/bmullvad}"
WG_CONF="${BMULLVAD_WG_CONF:-${HOME}/.config/wireguard/bmullvad.conf}"
LOCATION_FILE="${CONF_DIR}/location"
PEER_FILE="${CONF_DIR}/peer"
RELAYS_FILE="${CACHE_DIR}/relays.json"
RELAYS_URL="https://api.mullvad.net/www/relays/wireguard"
AMI_URL="https://am.i.mullvad.net/json"
DEFAULT_COUNTRY="nl"
DEFAULT_CITY="ams"

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
Manage the browser-only Mullvad connection
Usage: bmullvad <COMMAND>

Commands:
  connect      Connect to a VPN relay
  disconnect   Disconnect from the VPN
  reconnect    Reconnect to any matching VPN relay
  relay        Manage relay and tunnel constraints
  device       Check or register this config's key on the account
  status       Return the state of the VPN tunnel
  version      Show version
  help         Print this message

This is not system `mullvad`. Host apps, firefox, and Tailscale stay on the host net.
EOF
  exit "${code}"
}
need_ctl() {
  if [[ ! -x "${CTL}" ]]; then
    echo "bmullvad: missing ${CTL} (nixrebuild on sfnix so vpn-netns is live)" >&2
    exit 1
  fi
}

is_up() {
  [[ -e "${NS_PATH}" ]]
}

ensure_dirs() {
  mkdir -p "${CONF_DIR}" "${CACHE_DIR}"
}

relays_stale() {
  local mtime now
  [[ -f "${RELAYS_FILE}" ]] || return 0
  mtime=$(stat -c %Y "${RELAYS_FILE}" 2>/dev/null || echo 0)
  now=$(date +%s)
  (( now - mtime > 86400 ))
}

fetch_relays() {
  ensure_dirs
  "${CURL}" -fsS --max-time 20 "${RELAYS_URL}" -o "${RELAYS_FILE}.tmp"
  mv "${RELAYS_FILE}.tmp" "${RELAYS_FILE}"
}

ensure_relays() {
  if relays_stale; then
    fetch_relays
  fi
}

read_location() {
  COUNTRY="${DEFAULT_COUNTRY}"
  CITY="${DEFAULT_CITY}"
  HOSTNAME=""
  if [[ -f "${LOCATION_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${LOCATION_FILE}"
  fi
}

write_location() {
  ensure_dirs
  cat >"${LOCATION_FILE}" <<EOF
COUNTRY=${COUNTRY@Q}
CITY=${CITY@Q}
HOSTNAME=${HOSTNAME@Q}
EOF
}

write_peer_from_json() {
  local json="$1"
  ensure_dirs
  "${JQ}" -r '
    "hostname=" + .hostname,
    "country_code=" + .country_code,
    "country_name=" + .country_name,
    "city_code=" + .city_code,
    "city_name=" + .city_name,
    "PublicKey = " + .pubkey,
    "Endpoint = " + .ipv4_addr_in + ":51820"
  ' <<<"${json}" >"${PEER_FILE}"
}

pick_relay_json() {
  local country="$1" city="$2" host="$3"
  ensure_relays
  "${JQ}" -c --arg c "${country}" --arg y "${city}" --arg h "${host}" '
    map(select(.active == true))
    | if $h != "" then
        map(select(.hostname == $h))
      elif ($c | test("-wg-")) then
        map(select(.hostname == $c))
      else
        map(select(
          ($c == "" or $c == "any" or .country_code == $c)
          and ($y == "" or .city_code == $y)
        ))
      end
    | .[0] // empty
  ' "${RELAYS_FILE}"
}

resolve_peer() {
  read_location
  local json
  json=$(pick_relay_json "${COUNTRY}" "${CITY}" "${HOSTNAME}")
  if [[ -z "${json}" ]]; then
    echo "bmullvad: no matching WireGuard relay for ${COUNTRY} ${CITY} ${HOSTNAME}" >&2
    exit 1
  fi
  write_peer_from_json "${json}"
}

parse_location_args() {
  COUNTRY="${DEFAULT_COUNTRY}"
  CITY="${DEFAULT_CITY}"
  HOSTNAME=""
  if [[ $# -eq 0 ]]; then
    return 0
  fi
  if [[ $# -eq 1 && "$1" == *"-wg-"* ]]; then
    HOSTNAME="$1"
    COUNTRY=""
    CITY=""
    return 0
  fi
  COUNTRY="$1"
  CITY="${2:-}"
  HOSTNAME="${3:-}"
}

ctl_do() {
  need_ctl
  "${SUDO}" "${CTL}" "$1"
}

cmd_connect() {
  local wait=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w|--wait) wait=1; shift ;;
      -h|--help) echo "Usage: bmullvad connect [-w|--wait]"; exit 0 ;;
      *) echo "bmullvad connect: unknown option $1" >&2; exit 2 ;;
    esac
  done
  if [[ ! -f "${PEER_FILE}" ]]; then
    resolve_peer
  fi
  ctl_do connect
  if [[ "${wait}" -eq 1 ]]; then
    local n=0 state=""
    while (( n < 40 )); do
      state=$(tunnel_state)
      if [[ "${state}" == "connected" ]]; then
        cmd_status
        return 0
      fi
      n=$((n + 1))
      sleep 0.5
    done
    echo "bmullvad: netns is up but the tunnel is not passing traffic (${state})" >&2
    echo "  common cause: this config's key is not registered on the account." >&2
    echo "  check: bmullvad device check" >&2
    cmd_status || true
    return 1
  fi
}

cmd_disconnect() {
  ctl_do disconnect
}

cmd_reconnect() {
  if [[ ! -f "${PEER_FILE}" ]]; then
    resolve_peer
  fi
  ctl_do reconnect
}

visible_json() {
  if is_up && [[ -x "${NSEXEC}" ]]; then
    "${SUDO}" "${NSEXEC}" "${CURL}" -fsS --max-time 4 "${AMI_URL}"
  else
    "${CURL}" -fsS --max-time 4 "${AMI_URL}"
  fi
}

# Peer file mixes `hostname=x` and `PublicKey = base64==`. So trim the key
# and split on the FIRST '=' only: base64 values end with '=' themselves.
peer_field() {
  local key="$1"
  [[ -f "${PEER_FILE}" ]] || return 0
  awk -v k="${key}" '
    {
      eq = index($0, "=")
      if (eq == 0) next
      name = substr($0, 1, eq - 1)
      sub(/[ \t]+$/, "", name)
      if (name != k) next
      val = substr($0, eq + 1)
      sub(/^[ \t]+/, "", val)
      sub(/[ \t]+$/, "", val)
      print val
      exit
    }
  ' "${PEER_FILE}"
}

# Seconds since the last WireGuard handshake, or empty when there is none.
# A netns that exists but never handshook is a dead tunnel, not a connection:
# that is how an unregistered device key stayed invisible for weeks.
handshake_age() {
  local raw=""
  is_up || return 0
  [[ -x "${NSEXEC}" ]] || return 0
  raw=$("${SUDO}" "${NSEXEC}" "${WG}" show wg-browser latest-handshakes 2>/dev/null || true)
  raw=$(awk '{print $2; exit}' <<<"${raw}")
  [[ "${raw:-0}" =~ ^[0-9]+$ ]] || return 0
  (( raw == 0 )) && return 0
  echo $(( $(date +%s) - raw ))
}

# One word for the operator: connected, stale, or disconnected.
tunnel_state() {
  is_up || { echo disconnected; return 0; }
  local age="" vis=""
  age=$(handshake_age)
  if [[ -z "${age}" ]] || (( age > 180 )); then
    echo stale
    return 0
  fi
  vis=$(visible_json 2>/dev/null || true)
  if [[ -n "${vis}" ]] && [[ "$("${JQ}" -r '.mullvad_exit_ip // false' <<<"${vis}")" != "true" ]]; then
    echo stale
    return 0
  fi
  echo connected
}

cmd_status() {
  local verbose=0 json_out=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v|--verbose) verbose=1; shift ;;
      -j|--json) json_out=1; shift ;;
      -h|--help) echo "Usage: bmullvad status [-v] [-j]"; exit 0 ;;
      *) shift ;;
    esac
  done

  # every one gets an explicit empty default: `local x` alone is unbound under
  # `set -u`, so the old form killed status whenever the exit check failed.
  local vis="" city="" country="" ip="" exit_ip="" hostname="" city_name="" country_name=""
  vis=$(visible_json 2>/dev/null || true)
  if [[ -n "${vis}" ]]; then
    ip=$("${JQ}" -r '.ip // empty' <<<"${vis}")
    city=$("${JQ}" -r '.city // empty' <<<"${vis}")
    country=$("${JQ}" -r '.country // empty' <<<"${vis}")
    exit_ip=$("${JQ}" -r '.mullvad_exit_ip // false' <<<"${vis}")
  fi
  hostname=$(peer_field hostname)
  city_name=$(peer_field city_name)
  country_name=$(peer_field country_name)

  local state=""
  state=$(tunnel_state)

  if [[ "${json_out}" -eq 1 ]]; then
    "${JQ}" -n \
      --arg state "${state}" \
      --arg relay "${hostname}" \
      --arg ip "${ip:-}" \
      --arg city "${city:-}" \
      --arg country "${country:-}" \
      --argjson mullvad "${exit_ip:-false}" \
      '{state:$state, relay:$relay, ip:$ip, city:$city, country:$country, mullvad_exit_ip:$mullvad}'
    [[ "${state}" == "connected" ]]
    return
  fi

  case "${state}" in
    connected) echo "Connected" ;;
    stale) echo "Connected, but not passing traffic (relay unreachable or device key rejected)" ;;
    *) echo "Disconnected" ;;
  esac
  if [[ "${state}" != "disconnected" ]]; then
    if [[ -n "${hostname}" ]]; then
      echo "    Relay:                  ${hostname}"
    fi
    if [[ -n "${city_name}" || -n "${country_name}" ]]; then
      echo "    Location:               ${city_name:-?}, ${country_name:-?}"
    fi
  fi
  if [[ -n "${ip}" ]]; then
    echo "    Visible location:       ${country:-?}${city:+, ${city}}. IPv4: ${ip}"
  fi
  if [[ "${verbose}" -eq 1 ]] && is_up; then
    "${SUDO}" "${NSEXEC}" "${WG}" show wg-browser || true
  fi
  [[ "${state}" == "connected" ]]
}

cmd_relay_get() {
  read_location
  echo "Browser-only constraints"
  echo "    Location:               ${COUNTRY:-any}${CITY:+ ${CITY}}${HOSTNAME:+ ${HOSTNAME}}"
  if [[ -f "${PEER_FILE}" ]]; then
    echo "    Current relay:          $(peer_field hostname)"
    echo "    Endpoint:               $(awk -F= '/^Endpoint/ {sub(/^[[:space:]]+/, "", $2); print $2}' "${PEER_FILE}")"
  fi
}

cmd_relay_list() {
  ensure_relays
  "${JQ}" -r '
    map(select(.active == true))
    | group_by(.country_name)
    | .[]
    | (.[0].country_name) as $co
    | (.[0].country_code) as $cc
    | "\($co) (\($cc))",
      (group_by(.city_code)[]
        | "\t\(.[0].city_name) (\(.[0].city_code))",
          (.[] | "\t\t\(.hostname)"))
  ' "${RELAYS_FILE}"
}

cmd_relay_update() {
  fetch_relays
  echo "bmullvad: relay list updated"
}

cmd_relay_set_location() {
  parse_location_args "$@"
  write_location
  resolve_peer
  echo "Relay constraint: ${COUNTRY:-any} ${CITY} ${HOSTNAME} -> $(peer_field hostname)"
  if is_up; then
    swap_peer_in_place
  fi
}

# Point the running tunnel at the new peer without recreating the netns.
# A full reconnect would delete vpn-browser, which kills every process inside it —
# that is the browser. So: drop the old peer, add the new one, keep the ns.
swap_peer_in_place() {
  local endpoint old_peer new_peer
  endpoint=$(peer_field Endpoint)
  new_peer=$(peer_field PublicKey)
  if [[ -z "${endpoint}" || -z "${new_peer}" ]]; then
    echo "bmullvad: peer file incomplete; run relay set location first" >&2
    return 1
  fi
  # the old peer's public key is whatever wg currently has configured
  old_peer=$("${SUDO}" "${NSEXEC}" "${WG}" show wg-browser peers 2>/dev/null | head -1)
  if [[ -n "${old_peer}" ]]; then
    "${SUDO}" "${NSEXEC}" "${WG}" set wg-browser peer "${old_peer}" remove
  fi
  "${SUDO}" "${NSEXEC}" "${WG}" set wg-browser peer "${new_peer}" \
    endpoint "${endpoint}" \
    allowed-ips 0.0.0.0/0,::0/0 \
    persistent-keepalive 25
}

cmd_relay() {
  local sub="${1:-}"
  shift || true
  case "${sub}" in
    get) cmd_relay_get ;;
    list) cmd_relay_list ;;
    update) cmd_relay_update ;;
    set)
      local what="${1:-}"
      shift || true
      case "${what}" in
        location) cmd_relay_set_location "$@" ;;
        "") echo "Usage: bmullvad relay set location <COUNTRY> [CITY] [HOSTNAME]" >&2; exit 2 ;;
        *)
          echo "bmullvad: browser-scope supports 'relay set location' only (not ${what})" >&2
          exit 2
          ;;
      esac
      ;;
    help|"")
      cat >&2 <<'EOF'
Usage: bmullvad relay <COMMAND>
Commands:
  get       Display the current relay constraints
  set       Set relay constraints (location only)
  list      List available relays
  update    Update the relay list
EOF
      exit 2
      ;;
    *)
      echo "bmullvad relay: unknown command ${sub}" >&2
      exit 2
      ;;
  esac
}

cmd_version() {
  echo "bmullvad (browser-only Mullvad)"
}

# The private key in bmullvad.conf must belong to a device registered on the account.
# If it does not, WireGuard never handshakes and the netns sits there looking
# connected. Check it explicitly rather than discovering it by symptom.
account_number() {
  local acc="${BMULLVAD_ACCOUNT:-}"
  if [[ -z "${acc}" ]] && command -v mullvad >/dev/null 2>&1; then
    acc=$(mullvad account get 2>/dev/null | sed -n 's/^Mullvad account: *//p' | tr -d ' ')
  fi
  [[ -n "${acc}" ]] || return 1
  printf '%s' "${acc}"
}

access_token() {
  local acc
  acc=$(account_number) || {
    echo "bmullvad: cannot read the Mullvad account number (set BMULLVAD_ACCOUNT)" >&2
    return 1
  }
  "${CURL}" -fsS -X POST -H 'Content-Type: application/json' \
    -d "{\"account_number\":\"${acc}\"}" \
    https://api.mullvad.net/auth/v1/token | "${JQ}" -r '.access_token'
}

local_pubkey() {
  [[ -f "${WG_CONF}" ]] || return 1
  awk '/^PrivateKey/ {sub(/^PrivateKey *= */, ""); print}' "${WG_CONF}" |
    "${WG}" pubkey
}

cmd_device() {
  local action="${1:-check}"
  case "${action}" in
    check|register) ;;
    -h|--help) echo "Usage: bmullvad device [check|register]"; exit 0 ;;
    *) echo "bmullvad device: usage: bmullvad device [check|register]" >&2; exit 2 ;;
  esac

  local pub token devices found
  pub=$(local_pubkey) || { echo "bmullvad: missing ${WG_CONF}" >&2; exit 1; }
  token=$(access_token) || exit 1
  devices=$("${CURL}" -fsS -H "Authorization: Bearer ${token}" \
    https://api.mullvad.net/accounts/v1/devices) || {
    echo "bmullvad: could not list devices" >&2
    exit 1
  }
  found=$("${JQ}" -r --arg p "${pub}" \
    '[.[] | select(.pubkey == $p)] | .[0] // empty | "\(.name) \(.ipv4_address)"' <<<"${devices}")

  if [[ -n "${found}" ]]; then
    echo "Device key registered: ${found}"
    return 0
  fi

  echo "Device key NOT registered on the account." >&2
  echo "  pubkey: ${pub}" >&2
  echo "  without this, vpn-browser starts but never handshakes." >&2
  if [[ "${action}" != "register" ]]; then
    echo "  fix: bmullvad device register" >&2
    return 1
  fi

  local resp
  resp=$("${CURL}" -fsS -X POST -H 'Content-Type: application/json' \
    -H "Authorization: Bearer ${token}" \
    -d "{\"pubkey\":\"${pub}\",\"hijack_dns\":false}" \
    https://api.mullvad.net/accounts/v1/devices) || {
    echo "bmullvad: device registration failed" >&2
    exit 1
  }
  "${JQ}" -r '"Registered device: \(.name) \(.ipv4_address)"' <<<"${resp}"
  echo "note: the address Mullvad assigned may differ from the one in ${WG_CONF}."
}

# --- extension protocol -----------------------------------------------------
# The Cloak extension cannot run commands, so it speaks JSON over the native
# messaging host. One request on stdin, one reply on stdout. Never both logs
# and JSON on stdout: chrome parses the whole stream.
ext_reply() {
  "${JQ}" -c -n "$@"
}

ext_list() {
  ensure_relays
  "${JQ}" -c '
    { relays: [
        .[]
        | select(.active == true)
        | { cc: .country_code, cn: .country_name,
            cityCode: .city_code, city: .city_name } ] }
  ' "${RELAYS_FILE}"
}

# Local-only tunnel state: no network round trip, so the popup stays instant.
local_state() {
  if ! is_up; then
    echo disconnected
    return 0
  fi
  local age
  age=$(handshake_age)
  if [[ -z "${age}" ]] || (( age > 180 )); then
    echo stale
  else
    echo connected
  fi
}

ext_status() {
  local state relay city country codename ip=""
  state=$(local_state)
  relay=$(peer_field hostname)
  city=$(peer_field city_name)
  country=$(peer_field country_name)
  # country_code drives the little flag badge on the toolbar icon
  codename=$(peer_field country_code)

  ext_reply --arg state "${state}" --arg relay "${relay}" --arg ip "${ip}" \
    --arg city "${city}" --arg country "${country}" --arg cc "${codename}" \
    '{state:$state, relay:$relay, ip:$ip, city:$city, country:$country, cc:$cc}'
}

# Tear the tunnel down. Separate from `down` on purpose: this answers JSON on
# stdout, and the ctl path must not leak any text into that stream.
ext_down() {
  "${SUDO}" "${CTL}" disconnect >&2 2>/dev/null || true
  ext_reply --arg state "$(local_state)" '{state:$state}'
}

ext_set() {
  local cc="$1" city="$2"
  [[ -n "${cc}" ]] || { ext_reply --arg e "missing country code" '{error:$e}'; return 1; }
  # keep stdout clean: the switch writes its own text, so send it to stderr
  if [[ -n "${city}" ]]; then
    cmd_relay_set_location "${cc}" "${city}" >&2 || {
      ext_reply --arg e "could not switch" '{error:$e}'; return 1
    }
  else
    cmd_relay_set_location "${cc}" >&2 || {
      ext_reply --arg e "could not switch" '{error:$e}'; return 1
    }
  fi
  ext_reply --arg relay "$(peer_field hostname)" --arg state "$(tunnel_state)" \
    '{relay:$relay, state:$state}'
}

# Read one JSON request and answer it. Used as the native messaging host body.
cmd_ext() {
  local req op
  req=$(cat)
  op=$("${JQ}" -r '.op // empty' <<<"${req}" 2>/dev/null) || {
    ext_reply --arg e "bad request" '{error:$e}'
    return 1
  }
  case "${op}" in
    list) ext_list ;;
    status) ext_status ;;
    down) ext_down ;;
    set)
      ext_set "$("${JQ}" -r '.cc // empty' <<<"${req}")" \
              "$("${JQ}" -r '.city // empty' <<<"${req}")"
      ;;
    "")
      ext_reply --arg e "missing op" '{error:$e}'
      return 1
      ;;
    *)
      ext_reply --arg e "unknown op: ${op}" '{error:$e}'
      return 1
      ;;
  esac
}

cmd="${1:-}"
shift || true
case "${cmd}" in
  connect) cmd_connect "$@" ;;
  disconnect|down) cmd_disconnect "$@" ;;
  reconnect) cmd_reconnect "$@" ;;
  up) cmd_connect "$@" ;;
  status) cmd_status "$@" ;;
  device) cmd_device "$@" ;;
  ext) cmd_ext "$@" ;;
  relay) cmd_relay "$@" ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) usage 0 ;;
  "") usage 2 ;;
  *)
    echo "error: unrecognized subcommand" >&2
    usage
    ;;
esac
