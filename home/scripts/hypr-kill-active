#!/usr/bin/env bash
set -euo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="$state_dir/hypr-kill-active-last"
now=$(date +%s)

active_json=$(hyprctl activewindow -j 2>/dev/null || true)
if [[ -z "$active_json" || "$active_json" == "null" ]]; then
  exit 0
fi

address=$(jq -r '.address // ""' <<<"$active_json")
stable_id=$(jq -r '.stableId // ""' <<<"$active_json")
class=$(jq -r '.class // ""' <<<"$active_json")
title=$(jq -r '.title // ""' <<<"$active_json")
target="${stable_id:-$address}"

if [[ -f "$state_file" ]]; then
  IFS=$'\t' read -r last_time last_target < "$state_file" || true
  if [[ "${last_target:-}" == "$target" ]] && (( now - ${last_time:-0} <= 6 )); then
    rm -f "$state_file"
    hyprctl dispatch forcekillactive
    exit 0
  fi
fi

printf '%s\t%s\t%s\t%s\n' "$now" "$target" "$class" "$title" > "$state_file"
hyprctl dispatch killactive
