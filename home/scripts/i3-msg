#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2088
set -euo pipefail

# Compatibility shim for i3-era helpers running inside Sway.
# Many of the old scripts call i3-msg; swaymsg intentionally speaks the same IPC-ish language.
if command -v swaymsg >/dev/null 2>&1; then
  exec swaymsg "$@"
fi

echo "i3-msg shim: swaymsg is not available" >&2
exit 127
