set -euo pipefail

settings_dir="${XDG_DATA_HOME:-$HOME/.local/share}/com.pais.handy"
settings_file="$settings_dir/settings_store.json"

# Handy's own Tauri global shortcut is not reliable under Sway, and when the
# Handy window is focused it can double-fire alongside Sway's compositor bind.
# Move Handy's internal bindings to obscure valid chords; Sway owns Ctrl+Space.
if [ -f "$settings_file" ]; then
  tmp="$(mktemp)"
  jq '
    .settings.bindings.transcribe.current_binding = "ctrl+alt+shift+f12"
    | .settings.bindings.transcribe_with_post_process.current_binding = "ctrl+alt+shift+f11"
  ' "$settings_file" > "$tmp"
  install -m 0600 "$tmp" "$settings_file"
  rm -f "$tmp"
fi

exec handy --start-hidden
